<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat&family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet" />
  <style>
    html, body { height: 100%; margin: 0; background-color: #FFFADC; font-family: 'Montserrat', sans-serif; }
    .page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
    main { flex: 1; padding: 40px 20px; }

    .checkout-container { max-width: 650px; margin: 0 auto; }

    .section-title {
      font-family: 'Special Gothic Expanded One', sans-serif;
      text-align: center; margin-bottom: 30px; color: #333;
    }

    .order-summary {
      background: #fff; border: 2px solid #A4DD00;
      border-radius: 14px; padding: 20px 24px; margin-bottom: 30px;
    }
    .order-summary h5 {
      font-family: 'Special Gothic Expanded One', sans-serif;
      color: #555; margin-bottom: 14px;
    }
    .order-item {
      display: flex; justify-content: space-between;
      padding: 7px 0; border-bottom: 1px solid #f0f0f0; font-size: 15px;
    }
    .order-item:last-child { border-bottom: none; }
    .order-total {
      display: flex; justify-content: space-between;
      margin-top: 14px; font-size: 18px; font-weight: bold; color: #333;
    }

    .address-form {
      background: #fff; border-radius: 14px;
      box-shadow: 0 4px 16px rgba(164,221,0,0.18);
      padding: 30px 28px; border-top: 5px solid #A4DD00;
    }
    .address-form h5 {
      font-family: 'Special Gothic Expanded One', sans-serif;
      color: #555; margin-bottom: 18px;
    }
    .address-form label { font-weight: 600; color: #444; margin-top: 12px; display: block; }
    .address-form input,
    .address-form textarea,
    .address-form select {
      width: 100%; padding: 9px 12px; border-radius: 8px;
      border: 1px solid #ccc; margin-top: 5px; box-sizing: border-box;
      font-family: 'Montserrat', sans-serif;
    }
    .address-form input:focus,
    .address-form textarea:focus,
    .address-form select:focus {
      border-color: #A4DD00; outline: none;
      box-shadow: 0 0 0 2px rgba(164,221,0,0.3);
    }
    .address-form textarea { resize: vertical; }

    .btn-place-order {
      margin-top: 24px; width: 100%; background-color: #A4DD00; color: #222;
      font-weight: bold; border: none; border-radius: 10px;
      padding: 12px; font-size: 17px; cursor: pointer;
      font-family: 'Montserrat', sans-serif;
    }
    .btn-place-order:hover { background-color: #98CD00; }

    .footer {
      background-color: #A4DD00; color: #222; padding: 40px 20px;
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start;
    }
    .footer .column { flex: 1 1 200px; margin: 10px; }
    .footer h3 { color: #FFFADC; margin-bottom: 15px; }
    .footer a { color: #222; text-decoration: none; display: block; margin-bottom: 8px; font-size: 15px; }
    .footer a:hover { color: #B6F500; }
    .footer-bottom { background-color: #98CD00; text-align: center; padding: 15px; font-size: 14px; color: #333; }
    @media (max-width: 600px) { .footer { flex-direction: column; text-align: center; } }
  </style>
</head>
<body>
  <div class="page-wrapper">

    <!-- Header -->
    <header style="background-color: #A4DD00; display: flex; justify-content: center; align-items: center; height: 100px;">
      <img src="/images/logo.jpg" alt="Logo" style="height: 80px; width: auto;" />
      <h1 style="font-family: 'Special Gothic Expanded One', sans-serif; margin-left: 20px;">CHECKOUT</h1>
    </header>

    <main>
      <div class="checkout-container">
        <h2 class="section-title">Complete Your Order</h2>

        <!-- Order Summary -->
        <div class="order-summary">
          <h5>Order Summary</h5>
          <% let total = 0; %>
          <% products.forEach(function(product) { %>
            <% const price = Number(product.price); %>
            <% const qty = product.quantity || 1; %>
            <% total += price * qty; %>
            <div class="order-item">
              <span><%= product.item_name %> <span style="color:#aaa;">x<%= qty %></span></span>
              <span style="color:#98CD00; font-weight:bold;">Rs.<%= (price * qty).toFixed(2) %></span>
            </div>
          <% }); %>
          <div class="order-total">
            <span>Total</span>
            <span style="color:#A4DD00;">Rs.<%= total.toFixed(2) %></span>
          </div>
        </div>

        <!-- Address Form — field names match the addresses table exactly -->
        <div class="address-form">
          <h5>Delivery Address</h5>
          <form action="/cart/place-order" method="POST">

            <label for="full_name">Full Name</label>
            <input type="text" name="full_name" id="full_name"
              placeholder="Enter your full name" value="<%= username %>" required />

            <label for="phone">Phone Number</label>
            <input type="tel" name="phone" id="phone"
              placeholder="10-digit mobile number" pattern="[0-9]{10}" required />

            <label for="full_address">Address Line</label>
            <textarea name="full_address" id="full_address"
              rows="3" placeholder="House / Flat No., Street, Area" required></textarea>

            <label for="city">City</label>
            <input type="text" name="city" id="city" placeholder="City" required />

            <label for="state">State</label>
            <input type="text" name="state" id="state" placeholder="State" required />

            <label for="pincode">PIN Code</label>
            <input type="text" name="pincode" id="pincode"
              placeholder="6-digit PIN code" pattern="[0-9]{6}" required />

            <label for="country">Country</label>
            <input type="text" name="country" id="country"
              placeholder="Country" value="India" required />

            <label for="payment">Payment Method</label>
            <select name="payment" id="payment" required>
              <option value="" disabled selected>Select payment method</option>
              <option value="cod">Cash on Delivery</option>
              <option value="upi">UPI</option>
              <option value="card">Credit / Debit Card</option>
              <option value="netbanking">Net Banking</option>
            </select>

            <button type="submit" class="btn-place-order">Place Order</button>
          </form>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <div class="footer">
      <div class="column">
        <h3>Sell It</h3>
        <p>Your trusted marketplace for buying and selling.</p>
      </div>
      <div class="column">
        <h3>Quick Links</h3>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
      </div>
      <div class="column">
        <h3>Support</h3>
        <a href="#">Help</a>
        <a href="#">Terms</a>
      </div>
    </div>
    <div class="footer-bottom">&copy; 2025 Sell It. All rights reserved.</div>

  </div>
</body>
</html>