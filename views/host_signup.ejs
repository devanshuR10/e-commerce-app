<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Host Signup</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat&family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet">
  <style>
    html, body { height: 100%; margin: 0; background-color: #FFFADC; font-family: 'Montserrat', sans-serif; }
    .page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }
    main { flex: 1; display: flex; justify-content: center; align-items: center; padding: 40px 20px; }
    .form-card {
      background: #fff; border-radius: 16px;
      box-shadow: 0 4px 20px rgba(164,221,0,0.2);
      padding: 40px 36px; width: 100%; max-width: 440px;
      border-top: 6px solid #A4DD00;
    }
    .form-card h2 { font-family: 'Special Gothic Expanded One', sans-serif; text-align: center; margin-bottom: 24px; color: #333; }
    .form-card label { font-weight: 600; color: #444; margin-top: 12px; display: block; }
    .form-card input {
      width: 100%; padding: 9px 12px; border-radius: 8px;
      border: 1px solid #ccc; margin-top: 4px; box-sizing: border-box;
    }
    .form-card input:focus { border-color: #A4DD00; outline: none; box-shadow: 0 0 0 2px rgba(164,221,0,0.3); }
    .btn-submit {
      margin-top: 22px; width: 100%; background-color: #A4DD00; color: #222;
      font-weight: bold; border: none; border-radius: 10px;
      padding: 11px; font-size: 16px; cursor: pointer;
    }
    .btn-submit:hover { background-color: #98CD00; }
    .footer { background-color: #A4DD00; color: #222; padding: 40px 20px; display: flex; flex-wrap: wrap; justify-content: space-between; }
    .footer .column { flex: 1 1 200px; margin: 10px; }
    .footer h3 { color: #FFFADC; margin-bottom: 15px; }
    .footer a { color: #222; text-decoration: none; display: block; margin-bottom: 8px; }
    .footer a:hover { color: #B6F500; }
    .footer-bottom { background-color: #98CD00; text-align: center; padding: 15px; font-size: 14px; color: #333; }
  </style>
</head>
<body>
  <div class="page-wrapper">

    <header style="background-color: #A4DD00; display: flex; justify-content: center; align-items: center; height: 100px;">
      <img src="/images/logo.jpg" alt="Logo" style="height: 80px; width: auto;" />
      <h1 style="font-family: 'Special Gothic Expanded One', sans-serif; margin-left: 20px;">Host Signup</h1>
    </header>

    <main>
      <div class="form-card">
        <h2>Create Host Account</h2>

        <!-- ✅ action matches hostRouter.post('/host-signup') -->
        <!-- ✅ filename is host_signup.ejs (underscore) matching res.render('host_signup.ejs') -->
        <form method="POST" action="/host-signup">

          <label for="name">Full Name</label>
          <input type="text" name="name" id="name" placeholder="Your full name" required />

          <label for="email">Email Address</label>
          <input type="email" name="email" id="email" placeholder="you@example.com" required />
          <small class="text-muted">We'll never share your email with anyone else.</small>

          <label for="password">Password</label>
          <input type="password" name="password" id="password" placeholder="Create a strong password" required />

          <button type="submit" class="btn-submit">Sign Up</button>

          <p class="mt-3 text-center" style="font-size:14px;">
            Already have an account? <a href="/host-login" style="color:#A4DD00; font-weight:bold;">Log in</a>
          </p>
        </form>
      </div>
    </main>

    <div class="footer">
      <div class="column"><h3>Sell It</h3><p>Your trusted marketplace.</p></div>
      <div class="column">
        <h3>Quick Links</h3>
        <a href="#">Home</a><a href="#">About</a><a href="#">Contact</a>
      </div>
      <div class="column">
        <h3>Support</h3>
        <a href="#">Help</a><a href="#">Terms</a>
      </div>
    </div>
    <div class="footer-bottom">&copy; 2025 Sell It. All rights reserved.</div>

  </div>
</body>
</html>