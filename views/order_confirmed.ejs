<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmed</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #FFFADC;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background-color: #A4DD00;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 90px;
      gap: 16px;
    }

    header img { height: 65px; }

    header h1 {
      font-family: 'Special Gothic Expanded One', sans-serif;
      font-size: 1.6rem;
      color: #222;
    }

    main {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 50px 20px;
    }

    .confirm-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 6px 30px rgba(164, 221, 0, 0.25);
      padding: 48px 40px;
      max-width: 600px;
      width: 100%;
      border-top: 8px solid #A4DD00;
      text-align: center;
    }

    /* Animated checkmark */
    .checkmark-circle {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background-color: #A4DD00;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0 auto 24px;
      animation: pop 0.5s ease;
    }

    @keyframes pop {
      0%   { transform: scale(0); opacity: 0; }
      70%  { transform: scale(1.15); }
      100% { transform: scale(1); opacity: 1; }
    }

    .checkmark-circle svg {
      width: 48px;
      height: 48px;
      stroke: #fff;
      stroke-width: 3;
      fill: none;
      stroke-dasharray: 80;
      stroke-dashoffset: 80;
      animation: draw 0.6s 0.3s ease forwards;
    }

    @keyframes draw {
      to { stroke-dashoffset: 0; }
    }

    .confirm-card h2 {
      font-family: 'Special Gothic Expanded One', sans-serif;
      font-size: 1.8rem;
      color: #222;
      margin-bottom: 8px;
    }

    .confirm-card .subtitle {
      color: #666;
      font-size: 0.95rem;
      margin-bottom: 32px;
    }

    /* Details grid */
    .details-grid {
      background: #FFFADC;
      border-radius: 12px;
      padding: 20px 24px;
      text-align: left;
      margin-bottom: 28px;
      border: 1px solid #e8f5a0;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 10px 0;
      border-bottom: 1px dashed #d4ed6a;
      gap: 16px;
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-label {
      font-size: 0.82rem;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      white-space: nowrap;
      min-width: 110px;
    }

    .detail-value {
      font-size: 0.95rem;
      color: #222;
      font-weight: 600;
      text-align: right;
    }

    .detail-value.total {
      color: #A4DD00;
      font-size: 1.1rem;
    }

    /* Payment badge */
    .payment-badge {
      display: inline-block;
      background: #e8f5a0;
      color: #5a7a00;
      border-radius: 20px;
      padding: 3px 12px;
      font-size: 0.85rem;
      font-weight: 600;
    }

    /* Simulated payment steps */
    .payment-steps {
      margin-bottom: 28px;
    }

    .payment-steps h4 {
      font-size: 0.9rem;
      font-weight: 600;
      color: #555;
      text-align: left;
      margin-bottom: 14px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .step {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px dashed #e8e8e8;
      opacity: 0;
      transform: translateX(-10px);
      animation: slideIn 0.4s ease forwards;
    }

    .step:last-child { border-bottom: none; }
    .step:nth-child(1) { animation-delay: 0.3s; }
    .step:nth-child(2) { animation-delay: 0.7s; }
    .step:nth-child(3) { animation-delay: 1.1s; }
    .step:nth-child(4) { animation-delay: 1.5s; }

    @keyframes slideIn {
      to { opacity: 1; transform: translateX(0); }
    }

    .step-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #A4DD00;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 0.85rem;
      color: #fff;
      font-weight: bold;
    }

    .step-text {
      font-size: 0.88rem;
      color: #444;
    }

    .step-text strong { color: #222; }

    /* Buttons */
    .btn-home {
      display: inline-block;
      background-color: #A4DD00;
      color: #222;
      font-weight: bold;
      border: none;
      border-radius: 12px;
      padding: 13px 36px;
      font-size: 1rem;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s;
      margin: 6px;
    }

    .btn-home:hover { background-color: #98CD00; color: #222; }

    .btn-outline {
      display: inline-block;
      background-color: transparent;
      color: #A4DD00;
      font-weight: bold;
      border: 2px solid #A4DD00;
      border-radius: 12px;
      padding: 11px 32px;
      font-size: 1rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
      margin: 6px;
    }

    .btn-outline:hover { background-color: #A4DD00; color: #222; }

    /* Footer */
    .footer {
      background-color: #A4DD00;
      color: #222;
      padding: 36px 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .footer .column { flex: 1 1 180px; margin: 10px; }
    .footer h3 { color: #FFFADC; margin-bottom: 12px; }
    .footer a { color: #222; text-decoration: none; display: block; margin-bottom: 6px; font-size: 14px; }
    .footer a:hover { color: #B6F500; }
    .footer-bottom { background-color: #98CD00; text-align: center; padding: 14px; font-size: 13px; color: #333; }

    @media (max-width: 600px) {
      .confirm-card { padding: 32px 20px; }
      .detail-row { flex-direction: column; gap: 4px; }
      .detail-value { text-align: left; }
      .footer { flex-direction: column; }
    }
  </style>
</head>
<body>

  <header>
    <img src="/images/logo.jpg" alt="Logo" />
    <h1>Order Confirmed</h1>
  </header>

  <main>
    <div class="confirm-card">

      <!-- Animated tick -->
      <div class="checkmark-circle">
        <svg viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
          <polyline points="14,27 22,35 38,17" />
        </svg>
      </div>

      <h2>Thank You, <%= username %>!</h2>
      <p class="subtitle">Your order has been placed successfully. We'll get it to you soon.</p>

      <!-- Order details -->
      <div class="details-grid">
        <div class="detail-row">
          <span class="detail-label">Order ID</span>
          <span class="detail-value">#<%= orderId %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Delivery To</span>
          <span class="detail-value"><%= address %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Payment</span>
          <span class="detail-value">
            <span class="payment-badge"><%= payment %></span>
          </span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Total Paid</span>
          <span class="detail-value total">₹<%= total %></span>
        </div>
      </div>

      <!-- Simulated payment steps -->
      <div class="payment-steps">
        <h4>Payment Processing</h4>
        <div class="step">
          <div class="step-icon">✓</div>
          <div class="step-text"><strong>Order received</strong> — items reserved for you</div>
        </div>
        <div class="step">
          <div class="step-icon">✓</div>
          <div class="step-text"><strong>Payment verified</strong> — <%= payment %> confirmed</div>
        </div>
        <div class="step">
          <div class="step-icon">✓</div>
          <div class="step-text"><strong>Seller notified</strong> — preparing your package</div>
        </div>
        <div class="step">
          <div class="step-icon">✓</div>
          <div class="step-text"><strong>Shipment scheduled</strong> — estimated 3–5 business days</div>
        </div>
      </div>

      <!-- Actions -->
      <div>
        <a href="/" class="btn-home">Continue Shopping</a>
        <a href="/cart" class="btn-outline">Back to Cart</a>
      </div>

    </div>
  </main>

  <div class="footer">
    <div class="column">
      <h3>Sell It</h3>
      <p>Your trusted marketplace for buying and selling.</p>
    </div>
    <div class="column">
      <h3>Quick Links</h3>
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">Contact</a>
    </div>
    <div class="column">
      <h3>Support</h3>
      <a href="#">Help</a>
      <a href="#">Terms</a>
    </div>
  </div>
  <div class="footer-bottom">&copy; 2025 Sell It. All rights reserved.</div>

</body>
</html>