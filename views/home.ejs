<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="home.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet">
    <title>Document</title>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Segoe UI', sans-serif;
  background-color: #FFFADC;
}

header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  background-color: #A4DD00;
  padding: 15px 20px;
}

.logo_div { flex: 1 1 150px; }

.logo { height: 50px; width: auto; }

.search_button {
  flex: 3 1 400px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  width: 100%;
}

.input_search {
  flex: 1 1 200px;
  padding: 8px 12px;
  border: 2px solid #B6F500;
  border-radius: 5px;
  font-size: 16px;
  background-color: #FFFADC;
}

.search_bar_button,
.cart_button,
.host_button,
.login {
  padding: 8px 14px;
  background-color: #98CD00;
  border: none;
  border-radius: 5px;
  color: #222;
  font-weight: bold;
  cursor: pointer;
  text-decoration: none;
}

.search_bar_button:hover,
.cart_button:hover,
.host_button:hover {
  background-color: #B6F500;
}

.add_to_cart {
  padding: 8px 14px;
  background-color: #28a745;
  border: none;
  border-radius: 5px;
  color: white;
  font-weight: bold;
  cursor: pointer;
  margin-top: 8px;
}

.add_to_cart:hover {
  background-color: #218838;
}
</style>

</head>

<!-- ✅ FIX: pass username from backend so data attribute works -->
<body data-username="<%= username %>">

<header>
  <div class="logo_div">
    <img class="logo" src="images/logo.jpg" alt="Logo">
  </div>

  <div class="search_button">
    <form action="/search" method="GET" style="display:flex; gap:8px;">
      <input class="input_search" type="text" name="query" placeholder="Search for products..." required>
      <button class="search_bar_button" type="submit">Search</button>
    </form>

    <a class="login" href="/logout">Logout</a>
    <button class="cart_button">Check Cart</button>
    <button class="host_button">Login as Host</button>
  </div>
</header>

<div class="products">
  <h1 style="font-family: 'Special Gothic Expanded One', sans-serif; padding: 20px;">BUY NOW</h1>
</div>

<div class="all_card" style="display: flex; flex-wrap: wrap; gap: 20px; padding: 20px;">

  <% for (let i = 0; i < products.length; i++) { %>

    <div class="card" style="width: 18rem;">
      <img class="card-img-top" src="/images/logo.jpg" alt="Card image cap">

      <div class="card-body">
        <h5 class="card-title"><%= products[i].name %></h5>
        <p class="card-text"><%= products[i].description %></p>

        <p style="font-size: 1.2rem; font-weight: bold; color: #28a745; margin: 8px 0;">
          ₹<%= products[i].price %>
        </p>

        <a href="/info/<%= products[i].product_id %>" class="btn btn-primary">
          Product Info
        </a>

        <!-- ✅ data-product-id is correctly set -->
        <button class="add_to_cart" data-product-id="<%= products[i].product_id %>">
          Add To Cart
        </button>

      </div>
    </div>

  <% } %>

</div>

<footer>
  <div class="footer">
    <div class="column">
      <h3>Sell It</h3>
      <p>Your trusted marketplace for selling and buying with ease.</p>
    </div>

    <div class="column">
      <h3>Quick Links</h3>
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">How It Works</a>
      <a href="#">Contact</a>
    </div>

    <div class="column">
      <h3>Support</h3>
      <a href="#">FAQs</a>
      <a href="#">Help Center</a>
      <a href="#">Privacy Policy</a>
      <a href="#">Terms & Conditions</a>
    </div>
  </div>

  <div class="footer-bottom">
    &copy; 2025 Sell It. All rights reserved.
  </div>
</footer>

<script src="home.js"></script>

</body>
</html>