<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Successful</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat&family=Special+Gothic+Expanded+One&display=swap" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            margin: 0;
            background-color: #FFFADC;
            font-family: 'Montserrat', sans-serif;
        }

        .page-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .success-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(164, 221, 0, 0.25);
            padding: 50px 40px;
            text-align: center;
            max-width: 500px;
            width: 100%;
            border-top: 6px solid #A4DD00;
        }

        .success-card .tick {
            font-size: 60px;
            color: #A4DD00;
            margin-bottom: 10px;
        }

        .success-card h2 {
            font-family: 'Special Gothic Expanded One', sans-serif;
            color: #333;
            margin-bottom: 10px;
        }

        .success-card p {
            color: #555;
            font-size: 16px;
            margin-bottom: 6px;
        }

        .success-card .item-details {
            background: #f7ffe0;
            border: 1px solid #A4DD00;
            border-radius: 10px;
            padding: 16px;
            margin: 20px 0;
            text-align: left;
        }

        .success-card .item-details p {
            margin: 4px 0;
        }

        .success-card .item-details strong {
            color: #333;
        }

        .btn-green {
            background-color: #A4DD00;
            color: #222;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            padding: 10px 28px;
            font-size: 15px;
            text-decoration: none;
            display: inline-block;
            margin: 8px 6px 0;
            transition: background 0.2s;
        }

        .btn-green:hover {
            background-color: #98CD00;
            color: #111;
        }

        .btn-outline {
            background-color: transparent;
            color: #A4DD00;
            font-weight: bold;
            border: 2px solid #A4DD00;
            border-radius: 10px;
            padding: 10px 28px;
            font-size: 15px;
            text-decoration: none;
            display: inline-block;
            margin: 8px 6px 0;
            transition: background 0.2s;
        }

        .btn-outline:hover {
            background-color: #A4DD00;
            color: #111;
        }

        .footer {
            background-color: #A4DD00;
            color: #222;
            padding: 40px 20px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: flex-start;
        }

        .footer .column { flex: 1 1 200px; margin: 10px; }
        .footer h3 { color: #FFFADC; margin-bottom: 15px; }
        .footer a { color: #222; text-decoration: none; display: block; margin-bottom: 8px; font-size: 15px; }
        .footer a:hover { color: #B6F500; }

        .footer-bottom {
            background-color: #98CD00;
            text-align: center;
            padding: 15px;
            font-size: 14px;
            color: #333;
        }

        @media (max-width: 600px) {
            .footer { flex-direction: column; text-align: center; }
            .success-card { padding: 30px 20px; }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">

        <!-- Header -->
        <header style="background-color: #A4DD00; display: flex; justify-content: center; align-items: center; height: 100px;">
            <img src="/images/logo.jpg" alt="Logo" style="height: 80px; width: auto;" />
            <h1 style="font-family: 'Special Gothic Expanded One', sans-serif; margin-left: 20px;">Sell It</h1>
        </header>

        <!-- Main content -->
        <div class="content">
            <div class="success-card">
                <div class="tick">&#10003;</div>
                <h2>Upload Successful!</h2>
                <p>Hello, <strong><%= username %></strong>! Your item has been listed.</p>

                <div class="item-details">
                    <p><strong>Item:</strong> <%= itemName %></p>
                    <p><strong>Price:</strong> ₹<%= price %></p>
                </div>

                <a href="/" class="btn-green">Go to Home</a>
                <a href="/host" class="btn-outline">Upload More</a>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="column">
                <h3>Sell It</h3>
                <p>Your trusted marketplace for buying and selling.</p>
            </div>
            <div class="column">
                <h3>Quick Links</h3>
                <a href="#">Home</a>
                <a href="#">About</a>
                <a href="#">Contact</a>
            </div>
            <div class="column">
                <h3>Support</h3>
                <a href="#">Help</a>
                <a href="#">Terms</a>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2025 Sell It. All rights reserved.
        </div>

    </div>
</body>
</html>